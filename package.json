{
  "name": "cinemayur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.local.prisma && prisma db push --schema prisma/schema.local.prisma && next dev",
    "build": "prisma generate --schema prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:push:local": "prisma db push --schema prisma/schema.local.prisma",
    "db:seed": "prisma generate --schema prisma/schema.prisma && tsx prisma/seed.ts",
    "db:seed:local": "prisma generate --schema prisma/schema.local.prisma && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.19.0",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.5.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.439.0",
    "next": "14.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.10",
    "postcss": "^8.4.45",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
